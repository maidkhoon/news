# Supabase project settings (use the public/anon key, never the service-role key)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Dedicated BazaarNexa admin account for local MCP use
BAZAARNEXA_ADMIN_EMAIL=admin@example.com
BAZAARNEXA_ADMIN_PASSWORD=replace-with-your-admin-password

# Existing deployed API
BAZAARNEXA_API_URL=https://news-api-egmd.onrender.com
