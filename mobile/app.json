{
  "expo": {
    "name": "BazaarNexa",
    "slug": "bazaarnexa",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.maidkhoon.news",
      "permissions": ["NOTIFICATIONS", "VIBRATE"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#087BFF",
          "defaultChannel": "market-research"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://news-api-egmd.onrender.com"
    }
  }
}
